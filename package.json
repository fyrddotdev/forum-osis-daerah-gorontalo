{
  "name": "foda-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:studio": "pnpm --filter studio dev",
    "dev:all": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter web build"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.14.0",
      "onFail": "download"
    }
  }
}
